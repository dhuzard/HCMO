# Default end-user upper-level presentation for HCMO.
#
# The five declared classes retain their canonical BFO/IAO IRIs, source labels,
# definitions, and provenance. The direct links to BFO entity are presentation
# shortcuts that are entailed by the pinned source ontologies. They deliberately
# hide continuant/dependent-continuant intermediates from the default hierarchy.
#
# Ontology developers can load ontology/profiles/external-upper-developer.ttl
# alongside dist/hcmo.owl to restore the source-faithful intermediate hierarchy.
#
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/hcmo/ontology/external/upper-presentation> a owl:Ontology ;
    rdfs:label "HCMO end-user upper-level presentation" ;
    rdfs:comment "A checksummed, flattened presentation of five canonical BFO/IAO anchors for HCMO end users. Its shortcut hierarchy is entailed by the pinned sources; it does not replace BFO or IAO and does not assert equivalence with PROV-O, SIO, SULO, or ONTOP." ;
    dcterms:source <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl>,
        <http://purl.obolibrary.org/obo/iao/2026-03-30/iao.owl> ;
    owl:versionInfo "2026-07-31" .

BFO:0000001 a owl:Class ;
    rdfs:label "entity"@en ;
    skos:definition "(Elucidation) An entity is anything that exists or has existed or will exist"@en ;
    rdfs:subClassOf owl:Thing ;
    dcterms:source <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .

BFO:0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    skos:definition "(Elucidation) A material entity is an independent continuant that at all times at which it exists has some portion of matter as continuant part"@en ;
    rdfs:subClassOf BFO:0000001 ;
    dcterms:source <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .

IAO:0000030 a owl:Class ;
    rdfs:label "information content entity"@en ;
    skos:altLabel "information entity"@en ;
    skos:definition "A generically dependent continuant that is about some thing."@en ;
    rdfs:subClassOf BFO:0000001 ;
    dcterms:source <http://purl.obolibrary.org/obo/iao/2026-03-30/iao.owl> .

BFO:0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    skos:definition "(Elucidation) A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized"@en ;
    rdfs:subClassOf BFO:0000001 ;
    dcterms:source <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .

BFO:0000015 a owl:Class ;
    rdfs:label "process"@en ;
    skos:definition "(Elucidation) p is a process means p is an occurrent that has some temporal proper part and for some time t, p has some material entity as participant"@en ;
    rdfs:subClassOf BFO:0000001 ;
    dcterms:source <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> .
