@prefix hcm: <https://w3id.org/hcmo/ontology/hcm#> .
@prefix hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#> .
@prefix hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#> .
@prefix hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#> .
@prefix hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hcm:MonitoredEnclosureShape a sh:NodeShape ;
  sh:targetClass hcm:MonitoredEnclosure ;
  sh:property [
    sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm:hasEnclosureIdentifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm:hasDimensions ; sh:class hcm:EnclosureDimensions ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-tech:monitoredBy ; sh:class hcm-tech:Sensor ; sh:minCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasEnvironment ; sh:class hcm-env:EnvironmentProfile ; sh:maxCount 1
  ] .

hcm:EnclosureDimensionsShape a sh:NodeShape ;
  sh:targetClass hcm:EnclosureDimensions ;
  sh:property [
    sh:path hcm:hasWidthQuantity ; sh:class qudt:QuantityValue ; sh:node hcm:PositiveQuantityValueShape ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm:hasLengthQuantity ; sh:class qudt:QuantityValue ; sh:node hcm:PositiveQuantityValueShape ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm:hasHeightQuantity ; sh:class qudt:QuantityValue ; sh:node hcm:PositiveQuantityValueShape ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm:PositiveQuantityValueShape a sh:NodeShape ;
  sh:property [
    sh:path qudt:numericValue ; sh:nodeKind sh:Literal ; sh:minExclusive 0 ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path qudt:hasUnit ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm:QUDTQuantityValueShape a sh:NodeShape ;
  sh:targetClass qudt:QuantityValue ;
  sh:property [
    sh:path qudt:numericValue ; sh:nodeKind sh:Literal ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path qudt:hasUnit ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm:BoundedValidityIntervalShape a sh:NodeShape ;
  sh:targetObjectsOf time:hasTime ;
  sh:class time:Interval ;
  sh:property [
    sh:path time:hasBeginning ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
  ] ;
  sh:property [
    sh:path time:hasEnd ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
  ] ;
  sh:sparql [
    sh:message "A validity interval must have a beginning strictly earlier than its end." ;
    sh:select """
      PREFIX time: <http://www.w3.org/2006/time#>
      SELECT $this WHERE {
        $this time:hasBeginning/time:inXSDDateTime ?start ;
              time:hasEnd/time:inXSDDateTime ?end .
        FILTER (?start >= ?end)
      }
    """
  ] .

hcm:OperationalStatusRecordShape a sh:NodeShape ;
  sh:targetClass hcm:OperationalStatusRecord ;
  sh:property [
    sh:path hcm:hasOperationalStatusValue ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:class hcm:OperationalAssessment ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path time:hasTime ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [
      sh:class time:Interval ;
      sh:property [
        sh:path time:hasBeginning ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
      ] ;
      sh:property [
        sh:path time:hasEnd ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
      ]
    ]
  ] ;
  sh:sparql [
    sh:message "An operational status record must be generated by an assessment of the same enclosure that links to the record." ;
    sh:select """
      PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
      PREFIX prov: <http://www.w3.org/ns/prov#>
      SELECT $this WHERE {
        ?enclosure hcm:hasOperationalStatusRecord $this .
        $this prov:wasGeneratedBy ?assessment .
        FILTER NOT EXISTS { ?assessment hcm:assessesEnclosure ?enclosure }
      }
    """
  ] .

hcm-bio:SubjectShape a sh:NodeShape ;
  sh:targetClass hcm-bio:Subject ;
  sh:property [
    sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-bio:hasSpecies ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-bio:hasDateOfBirth ; sh:datatype xsd:date ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-bio:hasHousingAssignment ; sh:class hcm-bio:HousingAssignment ; sh:minCount 1
  ] .

hcm-bio:HousingAssignmentShape a sh:NodeShape ;
  sh:targetClass hcm-bio:HousingAssignment ;
  sh:property [
    sh:path [ sh:inversePath hcm-bio:hasHousingAssignment ] ;
    sh:minCount 1 ; sh:maxCount 1 ;
    sh:or ( [ sh:class hcm-bio:Subject ] [ sh:class hcm-bio:ExperimentalGroup ] )
  ] ;
  sh:property [
    sh:path hcm-bio:assignedToEnclosure ; sh:class hcm:MonitoredEnclosure ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path time:hasTime ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [
      sh:class time:Interval ;
      sh:property [
        sh:path time:hasBeginning ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
          sh:class time:Instant ;
          sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ]
        ]
      ] ;
      sh:property [
        sh:path time:hasEnd ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [
          sh:class time:Instant ;
          sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ]
        ]
      ]
    ]
  ] ;
  sh:sparql [
    sh:message "A housing validity interval must have a beginning strictly earlier than its end." ;
    sh:select """
      PREFIX time: <http://www.w3.org/2006/time#>
      SELECT $this
      WHERE {
        $this time:hasTime/time:hasBeginning/time:inXSDDateTime ?start ;
              time:hasTime/time:hasEnd/time:inXSDDateTime ?end .
        FILTER (?start >= ?end)
      }
    """
  ] ;
  sh:sparql [
    sh:message "A subject's housing assignments must not have overlapping half-open [start, end) validity intervals in the standard HCMO profile." ;
    sh:select """
      PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
      PREFIX time: <http://www.w3.org/2006/time#>
      SELECT $this
      WHERE {
        ?subject hcm-bio:hasHousingAssignment $this, ?other .
        FILTER ($this != ?other)
        $this time:hasTime/time:hasBeginning/time:inXSDDateTime ?start ;
              time:hasTime/time:hasEnd/time:inXSDDateTime ?end .
        ?other time:hasTime/time:hasBeginning/time:inXSDDateTime ?otherStart ;
               time:hasTime/time:hasEnd/time:inXSDDateTime ?otherEnd .
        FILTER (?start < ?otherEnd && ?otherStart < ?end)
      }
    """
  ] .

hcm-env:LightCycleShape a sh:NodeShape ;
  sh:targetClass hcm-env:LightCycle ;
  sh:property [
    sh:path hcm-env:hasDarkPhaseDuration ; sh:datatype xsd:duration ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasDarkPhaseStart ; sh:datatype xsd:time ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasDawnDuration ; sh:datatype xsd:duration ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasDuskDuration ; sh:datatype xsd:duration ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasLightPhaseDuration ; sh:datatype xsd:duration ; sh:maxCount 1
  ] .

hcm-env:MeasurementSpecificationShape a sh:NodeShape ;
  sh:targetClass hcm-env:MeasurementSpecification ;
  sh:property [
    sh:path hcm-env:specifiesProperty ; sh:class hcm-env:EnvironmentalProperty ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-env:hasSpecifiedValue ; sh:class qudt:QuantityValue ; sh:maxCount 1
  ] .

hcm-obs:EnvironmentObservationShape a sh:NodeShape ;
  sh:targetClass hcm-obs:EnvironmentObservation ;
  sh:property [
    sh:path sosa:observedProperty ; sh:class hcm-env:EnvironmentalProperty ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path sosa:hasResult ; sh:class hcm-obs:QuantityValue ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm-tech:SensorShape a sh:NodeShape ;
  sh:targetClass hcm-tech:Sensor ;
  sh:property [
    sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1
  ] ;
  sh:property [
    sh:path hcm-tech:hasSensorIdentifier ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-tech:installedIn ; sh:class hcm:MonitoredEnclosure
  ] .

hcm-tech:CalibrationRecordShape a sh:NodeShape ;
  sh:targetClass hcm-tech:CalibrationRecord ;
  sh:property [
    sh:path hcm-tech:hasCalibrationStatusValue ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path prov:wasGeneratedBy ; sh:class hcm-tech:CalibrationActivity ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path time:hasTime ; sh:minCount 1 ; sh:maxCount 1 ;
    sh:node [
      sh:class time:Interval ;
      sh:property [
        sh:path time:hasBeginning ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
      ] ;
      sh:property [
        sh:path time:hasEnd ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:node [ sh:class time:Instant ; sh:property [ sh:path time:inXSDDateTime ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] ]
      ]
    ]
  ] ;
  sh:sparql [
    sh:message "A calibration record must be generated by a calibration activity for the same sensor that links to the record." ;
    sh:select """
      PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
      PREFIX prov: <http://www.w3.org/ns/prov#>
      SELECT $this WHERE {
        ?sensor hcm-tech:hasCalibrationRecord $this .
        $this prov:wasGeneratedBy ?activity .
        FILTER NOT EXISTS { ?activity hcm-tech:calibratesSensor ?sensor }
      }
    """
  ] .

hcm-obs:BehaviorObservationShape a sh:NodeShape ;
  sh:targetClass hcm-obs:BehaviorObservation ;
  sh:property [
    sh:path sosa:hasFeatureOfInterest ; sh:class hcm-bio:Subject ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path sosa:madeBySensor ; sh:class hcm-tech:Sensor ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path sosa:hasResult ; sh:class hcm-obs:BehaviorResult ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path hcm-obs:occursIn ; sh:class hcm:MonitoredEnclosure ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm-obs:QuantityValueShape a sh:NodeShape ;
  sh:targetClass hcm-obs:QuantityValue ;
  sh:property [
    sh:path qudt:numericValue ; sh:nodeKind sh:Literal ; sh:minCount 1 ; sh:maxCount 1
  ] ;
  sh:property [
    sh:path qudt:hasUnit ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1
  ] .

hcm:RejectedTimelessStateShape a sh:NodeShape ;
  sh:targetSubjectsOf hcm:isOccupied, hcm:isOperational, hcm-tech:isCalibrated ;
  sh:sparql [
    sh:message "Timeless occupancy, operational, and calibration booleans are deprecated in the standard HCMO profile." ;
    sh:select """
      PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
      PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
      SELECT $this WHERE {
        VALUES ?property { hcm:isOccupied hcm:isOperational hcm-tech:isCalibrated }
        $this ?property ?value .
      }
    """
  ] .

hcm-obs:ObservationIntervalShape a sh:NodeShape ;
  sh:targetSubjectsOf hcm-obs:hasInterval ;
  sh:property [
    sh:path hcm-obs:hasInterval ; sh:datatype xsd:duration ; sh:maxCount 1
  ] .

hcm-tech:TimeSeriesShape a sh:NodeShape ;
  sh:targetClass hcm-tech:TimeSeries ;
  sh:property [
    sh:path hcm-tech:hasFileFormat ; sh:datatype xsd:string ; sh:minCount 1
  ] ;
  sh:property [
    sh:path hcm-tech:hasStoragePath ; sh:datatype xsd:string ; sh:minCount 1
  ] .
