bb:box-1-nosepoke a hcm-tech:Sensor ;
    rdfs:label "Nose-poke IR beam sensor, BEATBox 1" ;
    hcm-tech:captures bb:discrimination-choice ;
    hcm-tech:communicatesWith bb:box-1-main-controller ;
    hcm-tech:hasSensorIdentifier "BB-1-NOSEPOKE" ;
    hcm-tech:hasSensorTechnology "infrared beam-break" ;
    hcm-tech:installedIn bb:box-1 .

bb:box-2-nosepoke a hcm-tech:Sensor ;
    rdfs:label "Nose-poke IR beam sensor, BEATBox 2" ;
    hcm-tech:captures bb:discrimination-choice ;
    hcm-tech:communicatesWith bb:box-2-main-controller ;
    hcm-tech:hasSensorIdentifier "BB-2-NOSEPOKE" ;
    hcm-tech:hasSensorTechnology "infrared beam-break" ;
    hcm-tech:installedIn bb:box-2 .

bb:box-3-nosepoke a hcm-tech:Sensor ;
    rdfs:label "Nose-poke IR beam sensor, BEATBox 3" ;
    hcm-tech:captures bb:discrimination-choice ;
    hcm-tech:communicatesWith bb:box-3-main-controller ;
    hcm-tech:hasSensorIdentifier "BB-3-NOSEPOKE" ;
    hcm-tech:hasSensorTechnology "infrared beam-break" ;
    hcm-tech:installedIn bb:box-3 .

bb:box-4-nosepoke a hcm-tech:Sensor ;
    rdfs:label "Nose-poke IR beam sensor, BEATBox 4" ;
    hcm-tech:captures bb:discrimination-choice ;
    hcm-tech:communicatesWith bb:box-4-main-controller ;
