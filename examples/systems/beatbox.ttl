bb:trial-table a hcm-tech:TimeSeries ;
    rdfs:label "BEATBox trial table (designed export)" ;
    prov:wasAttributedTo bb:beatbox-gui ;
    hcm-tech:hasFileFormat "text/csv" ;
    hcm-tech:hasStoragePath "docs/hcm-systems/systems/beatbox/datasets/mock/beatbox_trials.csv" .

bb:box-1-dimensions a hcm:EnclosureDimensions ;
    hcm:hasHeightQuantity bb:box-1-dimensions-height ;
    hcm:hasLengthQuantity bb:box-1-dimensions-length ;
    hcm:hasWidthQuantity bb:box-1-dimensions-width .

bb:box-1-dimensions-height a qudt:QuantityValue ;
    qudt:hasUnit unit:CentiM ;
    qudt:numericValue 25.0 .

