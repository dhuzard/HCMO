bb:mouse-2 a hcm-bio:Subject ;
    rdfs:label "Mouse BB-002 (BALB/cJ, BEATBox 2)" ;
    dcterms:identifier "BB-002" ;
    hcm-bio:hasBiologicalSex "female" ;
    hcm-bio:hasDateOfBirth "2026-02-01"^^xsd:date ;
    hcm-bio:hasHousingAssignment bb:housing-mouse-2 ;
    hcm-bio:hasSpecies "Mus musculus" ;
    hcm-bio:hasStrain "BALB/cJ" .

bb:box-2 a hcm:MonitoredEnclosure ;
    rdfs:label "BEATBox 2 home-cage compartment" ;
    rdfs:comment "Home-cage compartment with door wall, tunnel, feeder, two touch screens, nose poke, lighting and IR barriers; dimensions assumed for the synthetic profile." ;
    hcm:hasDimensions bb:box-2-dimensions ;
    hcm:hasEnclosureIdentifier "BEATBox-2" ;
    hcm:hasEnrichment bb:box-2-nesting ;
    hcm-env:hasEnvironment bb:beatbox-room-profile ;
    hcm-tech:hasActuator bb:box-2-feeder,
        bb:box-2-lighting,
        bb:box-2-screen-left-display,
        bb:box-2-screen-right-display ;
    hcm-tech:monitoredBy bb:box-2-feeder-barrier,
        bb:box-2-nosepoke,
        bb:box-2-screen-left-touch,
        bb:box-2-screen-right-touch .

