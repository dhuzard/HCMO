    hcm-tech:installedIn bb:box-4 .

bb:beatbox-room-profile a hcm-env:EnvironmentProfile ;
    rdfs:label "BEATBox room environment profile" ;
    hcm-env:hasLightCycle bb:light-cycle-12-12 .

bb:session-accuracy a sosa:ObservableProperty ;
    rdfs:label "session accuracy (share of correct trials)" .

bb:session-trial-count a sosa:ObservableProperty ;
    rdfs:label "number of self-initiated trials in the session" .

bb:box-1-main-controller a hcm-tech:Hardware ;
    rdfs:label "Raspberry Pi main controller of BEATBox 1 (BB_RPi_shield_V1.1)" ;
    hcm-tech:hasModelNumber "BB_RPi_shield_V1.1" ;
    hcm-tech:hasProtocol "CAN 2.0A 11-bit inter-module protocol" ;
    hcm-tech:supportsEnclosure bb:box-1 .

bb:box-2-main-controller a hcm-tech:Hardware ;
    rdfs:label "Raspberry Pi main controller of BEATBox 2 (BB_RPi_shield_V1.1)" ;
    hcm-tech:hasModelNumber "BB_RPi_shield_V1.1" ;
    hcm-tech:hasProtocol "CAN 2.0A 11-bit inter-module protocol" ;
    hcm-tech:supportsEnclosure bb:box-2 .

bb:box-3-main-controller a hcm-tech:Hardware ;
    rdfs:label "Raspberry Pi main controller of BEATBox 3 (BB_RPi_shield_V1.1)" ;
    hcm-tech:hasModelNumber "BB_RPi_shield_V1.1" ;
    hcm-tech:hasProtocol "CAN 2.0A 11-bit inter-module protocol" ;
    hcm-tech:supportsEnclosure bb:box-3 .

bb:box-4-main-controller a hcm-tech:Hardware ;
    rdfs:label "Raspberry Pi main controller of BEATBox 4 (BB_RPi_shield_V1.1)" ;
    hcm-tech:hasModelNumber "BB_RPi_shield_V1.1" ;
    hcm-tech:hasProtocol "CAN 2.0A 11-bit inter-module protocol" ;
    hcm-tech:supportsEnclosure bb:box-4 .

bb:beatbox-gui a hcm-tech:Software ;
    rdfs:label "BEATBox Python control and monitoring GUI (Raspberry Pi)" ;
    hcm-tech:communicatesWith bb:box-1-main-controller,
        bb:box-2-main-controller,
        bb:box-3-main-controller,
        bb:box-4-main-controller ;
    hcm-tech:runsOn bb:box-1-main-controller,
        bb:box-2-main-controller,
        bb:box-3-main-controller,
        bb:box-4-main-controller .

bb:box-1-screen-right-touch a hcm-tech:Sensor ;
