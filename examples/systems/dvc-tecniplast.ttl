dvc:cohort-7623-b6-m a hcm-bio:ExperimentalGroup ;
    rdfs:label "Cohort 7623 group B6_M" ;
    rdfs:comment "Export group label 'B6_M' (C57BL/6 males per the contributor). Strain and sex are not attributable to individual subjects because the export carries no animal identity." .

dvc:rack-aaaa-controller a hcm-tech:Hardware ;
    rdfs:label "DVC rack AAAA controller" ;
    schema:manufacturer dvc:tecniplast ;
    hcm-tech:communicatesWith dvc:dvc-analytics .

dvc:rack-aaaa-cage-detection a prov:Activity,
        hcm:OperationalAssessment ;
    rdfs:label "DVC rack AAAA cage-presence detection (INSERTED/REMOVED events)" ;
    prov:wasAssociatedWith dvc:rack-aaaa-controller ;
    hcm:assessesEnclosure dvc:cage-b6-m-12-34,
        dvc:cage-b6-m-12-3401,
        dvc:cage-b6-m-12-3402,
        dvc:cage-b6-m-12-3403,
