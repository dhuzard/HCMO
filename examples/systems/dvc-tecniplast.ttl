dvc:cohort-7623-export a prov:Entity,
        schema:Dataset ;
    rdfs:label "Real DVC Analytics export, cohort 7623, group B6_M (rack AAAA)" ;
    dcterms:source "docs/hcm-systems/systems/DVC_Tecniplast/datasets/real/README.md" ;
    dcterms:type "real export" ;
    schema:description "Real Tecniplast DVC export contributed for HCMO validation: 24 cages on one rack, 14 days at 1-minute resolution. Four cages and a three-hour window of activation-index bins are materialised." .

dvc:cohort-b6-f-mock-export a prov:Entity,
        schema:Dataset ;
    rdfs:label "Synthetic DVC export, group B6_F (rack BBBB)" ;
    dcterms:source "docs/hcm-systems/systems/DVC_Tecniplast/datasets/mock/README.md" ;
    dcterms:type "synthetic schema-faithful export" ;
    schema:description "Schema-faithful synthetic DVC export (8 cages, 3 days) generated by datasets/mock/generate_dvc_traces.py so that the scenario also holds cages of females. Two cages and a two-hour window are materialised." .

