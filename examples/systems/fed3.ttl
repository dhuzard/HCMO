fed:fed3-device-1 a hcm-tech:Hardware ;
    rdfs:label "FED3 device 1 (open-source operant feeder)" ;
    dcterms:identifier "1" ;
    rdfs:comment "Battery-powered Adafruit Feather M0 Adalogger based device; logs to SD card. Library_Version is recorded as firmware." ;
    hcm-tech:hasFirmware "1.16.3" ;
    hcm-tech:hasModelNumber "FED3" ;
    hcm-tech:supportsEnclosure fed:cage-fed-1 .

fed:fed3-right-poke-sensor a hcm-tech:Sensor ;
    rdfs:label "FED3 right nose-poke photointerrupter" ;
    hcm-tech:captures fed:nose-poke-event ;
    hcm-tech:communicatesWith fed:fed3-device-1 ;
    hcm-tech:hasSensorIdentifier "FED3-1-right-poke" ;
    hcm-tech:hasSensorTechnology "infrared photointerrupter" ;
    hcm-tech:installedIn fed:cage-fed-1 .

fed:fed3-left-poke-sensor a hcm-tech:Sensor ;
    rdfs:label "FED3 left nose-poke photointerrupter" ;
    hcm-tech:captures fed:nose-poke-event ;
    hcm-tech:communicatesWith fed:fed3-device-1 ;
    hcm-tech:hasSensorIdentifier "FED3-1-left-poke" ;
    hcm-tech:hasSensorTechnology "infrared photointerrupter" ;
    hcm-tech:installedIn fed:cage-fed-1 .

fed:fed3-pellet-well-sensor a hcm-tech:Sensor ;
    rdfs:label "FED3 pellet-well photointerrupter" ;
    hcm-tech:captures fed:pellet-retrieval-latency ;
    hcm-tech:communicatesWith fed:fed3-device-1 ;
    hcm-tech:hasSensorIdentifier "FED3-1-pellet-well" ;
    hcm-tech:hasSensorTechnology "infrared photointerrupter" ;
    hcm-tech:installedIn fed:cage-fed-1 .

fed:pellet-retrieval-latency a sosa:ObservableProperty ;
    rdfs:label "pellet retrieval latency" .

fed:nose-poke-event a sosa:ObservableProperty ;
    rdfs:label "nose-poke event (left or right port)" .

fed:fr1-left-active a sosa:Procedure ;
    rdfs:label "FED3 session type FR1, active poke Left" ;
    rdfs:comment "Fixed-ratio 1: every active (left) nose-poke dispenses one 20-mg pellet; right pokes are recorded but not rewarded." .

fed:mouse-1 a hcm-bio:Subject ;
    rdfs:label "Mouse 1 (FED3 device 1)" ;
    dcterms:identifier "FED3-1-mouse" ;
    hcm-bio:hasBiologicalSex "male" ;
    hcm-bio:hasDateOfBirth "2026-01-05"^^xsd:date ;
    hcm-bio:hasHousingAssignment fed:housing-mouse-1 ;
    hcm-bio:hasSpecies "Mus musculus" ;
    hcm-bio:hasStrain "C57BL/6J" .

fed:cage-fed-1 a hcm:MonitoredEnclosure ;
    rdfs:label "Home cage with FED3 device 1" ;
    rdfs:comment "Standard mouse shoebox cage; the FED3 sits inside the cage. Dimensions are assumed for the synthetic profile." ;
    hcm:hasDimensions fed:cage-fed-1-dimensions ;
    hcm:hasEnclosureIdentifier "FED-cage-1" ;
    hcm:hasEnrichment fed:cage-fed-1-nesting ;
