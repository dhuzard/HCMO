pt:behavior-recognition a sosa:Procedure ;
    rdfs:label "EthoVision Behavior Recognition module (rodent)" ;
    rdfs:comment "Automatic classification of grooming, rearing, eating and sniffing from the video; no confidence scores are exported." .

pt:behavior-category a sosa:ObservableProperty ;
    rdfs:label "recognised behaviour category" .

pt:distance-moved a sosa:ObservableProperty ;
    rdfs:label "distance moved (centre-point)" .

pt:mean-velocity a sosa:ObservableProperty ;
    rdfs:label "mean velocity (centre-point)" .

pt:time-in-shelter a sosa:ObservableProperty ;
    rdfs:label "time in shelter zone" .

pt:time-moving a sosa:ObservableProperty ;
    rdfs:label "time in movement state" .

pt:mouse-1 a hcm-bio:Subject ;
    rdfs:label "Mouse 1 (PhenoTyper arena 1)" ;
    dcterms:identifier "mouse-1" ;
    hcm-bio:hasBiologicalSex "female" ;
    hcm-bio:hasDateOfBirth "2026-01-20"^^xsd:date ;
    hcm-bio:hasHousingAssignment pt:housing-mouse-1 ;
    hcm-bio:hasSpecies "Mus musculus" ;
    hcm-bio:hasStrain "C57BL/6J" .

pt:mouse-2 a hcm-bio:Subject ;
    rdfs:label "Mouse 2 (PhenoTyper arena 2)" ;
    dcterms:identifier "mouse-2" ;
    hcm-bio:hasBiologicalSex "female" ;
    hcm-bio:hasDateOfBirth "2026-01-20"^^xsd:date ;
    hcm-bio:hasHousingAssignment pt:housing-mouse-2 ;
    hcm-bio:hasSpecies "Mus musculus" ;
    hcm-bio:hasStrain "C57BL/6J" .

pt:arena-1-camera a hcm-tech:Sensor ;
    rdfs:label "Top-unit infrared-sensitive camera, arena 1" ;
    hcm-tech:captures pt:behavior-category,
        pt:centre-point-position,
        pt:distance-moved,
        pt:mean-velocity,
        pt:time-in-shelter,
        pt:time-moving ;
    hcm-tech:communicatesWith pt:ethovision-workstation ;
    hcm-tech:hasSamplingRateQuantity pt:arena-1-camera-sampling-rate ;
    hcm-tech:hasSensorIdentifier "PT-camera-1" ;
    hcm-tech:hasSensorTechnology "infrared video" ;
    hcm-tech:hasSensorType "video camera" ;
    hcm-tech:installedIn pt:arena-1 .

pt:arena-2-camera a hcm-tech:Sensor ;
    rdfs:label "Top-unit infrared-sensitive camera, arena 2" ;
    hcm-tech:captures pt:behavior-category,
        pt:centre-point-position,
        pt:distance-moved,
        pt:mean-velocity,
        pt:time-in-shelter,
        pt:time-moving ;
    hcm-tech:communicatesWith pt:ethovision-workstation ;
    hcm-tech:hasSamplingRateQuantity pt:arena-2-camera-sampling-rate ;
    hcm-tech:hasSensorIdentifier "PT-camera-2" ;
    hcm-tech:hasSensorTechnology "infrared video" ;
    hcm-tech:hasSensorType "video camera" ;
    hcm-tech:installedIn pt:arena-2 .

pt:arena-1 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoTyper 3000 home cage, arena 1" ;
    rdfs:comment "PhenoTyper 3000 (30 x 30 cm) with shelter, top unit with IR-sensitive camera and white/IR LED units." ;
    hcm:hasDimensions pt:arena-1-dimensions ;
    hcm:hasEnclosureIdentifier "Arena 1" ;
    hcm:hasEnrichment pt:arena-1-shelter ;
    hcm:hasManufacturer "Noldus Information Technology" ;
    hcm-env:hasEnvironment pt:phenotyper-room-profile ;
    hcm-tech:hasActuator pt:arena-1-ir-led,
        pt:arena-1-white-led ;
    hcm-tech:monitoredBy pt:arena-1-camera .

pt:arena-2 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoTyper 3000 home cage, arena 2" ;
    rdfs:comment "PhenoTyper 3000 (30 x 30 cm) with shelter, top unit with IR-sensitive camera and white/IR LED units." ;
    hcm:hasDimensions pt:arena-2-dimensions ;
    hcm:hasEnclosureIdentifier "Arena 2" ;
    hcm:hasEnrichment pt:arena-2-shelter ;
    hcm:hasManufacturer "Noldus Information Technology" ;
    hcm-env:hasEnvironment pt:phenotyper-room-profile ;
    hcm-tech:hasActuator pt:arena-2-ir-led,
        pt:arena-2-white-led ;
    hcm-tech:monitoredBy pt:arena-2-camera .

pt:centre-point-tracking a sosa:Procedure ;
    rdfs:label "EthoVision centre-point detection and time-bin statistics" ;
    rdfs:comment "Centre-point detection on the top-unit IR video at 25 samples/s; distance, velocity and zone/movement durations aggregated per 1-min bin." .

