    rdfs:label "Mouse 4 (PhenoMaster animal no. 4)" ;
    dcterms:identifier "4" ;
    hcm-bio:hasBiologicalSex "female" ;
    hcm-bio:hasDateOfBirth "2026-02-10"^^xsd:date ;
    hcm-bio:hasHousingAssignment tse:housing-mouse-4 ;
    hcm-bio:hasSpecies "Mus musculus" ;
    hcm-bio:hasStrain "C57BL/6J" .

tse:box-1 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoMaster calorimetry box 1" ;
    rdfs:comment "Sealed home-cage calorimetry box; dimensions are assumed for the synthetic profile." ;
    hcm:hasDimensions tse:box-1-dimensions ;
    hcm:hasEnclosureIdentifier "Box 1" ;
    hcm:hasEnrichment tse:box-1-nesting ;
    hcm:hasManufacturer "TSE Systems GmbH" ;
    hcm-env:hasEnvironment tse:calorimetry-room-profile ;
    hcm-tech:monitoredBy tse:actimot-frame-1,
        tse:drink-sensor-1,
        tse:feed-sensor-1,
        tse:gas-analyzer,
        tse:temp-sensor-1,
        tse:weight-sensor-1 .

tse:box-2 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoMaster calorimetry box 2" ;
    rdfs:comment "Sealed home-cage calorimetry box; dimensions are assumed for the synthetic profile." ;
    hcm:hasDimensions tse:box-2-dimensions ;
    hcm:hasEnclosureIdentifier "Box 2" ;
    hcm:hasEnrichment tse:box-2-nesting ;
    hcm:hasManufacturer "TSE Systems GmbH" ;
    hcm-env:hasEnvironment tse:calorimetry-room-profile ;
    hcm-tech:monitoredBy tse:actimot-frame-2,
        tse:drink-sensor-2,
        tse:feed-sensor-2,
        tse:gas-analyzer,
        tse:temp-sensor-2,
        tse:weight-sensor-2 .

tse:box-3 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoMaster calorimetry box 3" ;
    rdfs:comment "Sealed home-cage calorimetry box; dimensions are assumed for the synthetic profile." ;
    hcm:hasDimensions tse:box-3-dimensions ;
    hcm:hasEnclosureIdentifier "Box 3" ;
    hcm:hasManufacturer "TSE Systems GmbH" ;
    hcm-env:hasEnvironment tse:calorimetry-room-profile ;
    hcm-tech:monitoredBy tse:actimot-frame-3,
        tse:drink-sensor-3,
        tse:feed-sensor-3,
        tse:gas-analyzer,
        tse:temp-sensor-3,
        tse:weight-sensor-3 .

tse:box-4 a hcm:MonitoredEnclosure ;
    rdfs:label "PhenoMaster calorimetry box 4" ;
    rdfs:comment "Sealed home-cage calorimetry box; dimensions are assumed for the synthetic profile." ;
    hcm:hasDimensions tse:box-4-dimensions ;
    hcm:hasEnclosureIdentifier "Box 4" ;
    hcm:hasManufacturer "TSE Systems GmbH" ;
    hcm-env:hasEnvironment tse:calorimetry-room-profile ;
    hcm-tech:monitoredBy tse:actimot-frame-4,
        tse:drink-sensor-4,
        tse:feed-sensor-4,
        tse:gas-analyzer,
        tse:temp-sensor-4,
        tse:weight-sensor-4 .

tse:indirect-calorimetry-procedure a sosa:Procedure ;
    rdfs:label "PhenoMaster open-circuit indirect calorimetry" ;
    rdfs:comment "VO2 and VCO2 from the O2/CO2 differential between reference and box air at the configured flow; RER = VCO2/VO2; heat by the Weir equation." .

tse:gas-analyzer a hcm-tech:Sensor ;
    rdfs:label "PhenoMaster O2/CO2 gas analyzer (shared, sequential box sampling)" ;
    hcm-tech:captures tse:box-carbon-dioxide-concentration,
        tse:box-oxygen-concentration,
        tse:carbon-dioxide-production-rate,
        tse:heat-production,
        tse:oxygen-consumption-rate,
        tse:respiratory-exchange-ratio ;
    hcm-tech:communicatesWith tse:phenomaster-control-unit ;
    hcm-tech:hasSensorIdentifier "TSE-gas-analyzer-1" ;
    hcm-tech:hasSensorTechnology "paramagnetic O2 and infrared CO2 analysis" .

