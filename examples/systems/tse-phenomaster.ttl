tse:phenomaster-export-series a hcm-tech:TimeSeries ;
    rdfs:label "PhenoMaster table export, 4 animals, 15-min intervals" ;
    prov:wasAttributedTo tse:phenomaster-software ;
    hcm-tech:hasFileFormat "text/csv" ;
    hcm-tech:hasStoragePath "docs/hcm-systems/systems/tse-phenomaster/datasets/mock/phenomaster_mock_export.csv" .

tse:phenomaster-mock-export a prov:Entity,
        schema:Dataset ;
    rdfs:label "Synthetic TSE PhenoMaster export (4 boxes, 3 h, 15-min intervals)" ;
    dcterms:source "docs/hcm-systems/systems/tse-phenomaster/README.md" ;
    dcterms:type "synthetic schema-faithful export" ;
    schema:description "Schema-faithful synthetic PhenoMaster table export; values are generated, not measured. Column set reconstructed from the CalR TSE import specification and published supplementary tables." .

tse:box-1-dimensions a hcm:EnclosureDimensions ;
    hcm:hasHeightQuantity tse:box-1-dimensions-height ;
    hcm:hasLengthQuantity tse:box-1-dimensions-length ;
    hcm:hasWidthQuantity tse:box-1-dimensions-width .

tse:box-1-dimensions-height a qudt:QuantityValue ;
    qudt:hasUnit unit:CentiM ;
    qudt:numericValue 14.0 .

