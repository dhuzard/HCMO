    rdfs:label "Nesting material in the arena" ;
    hcm:hasEnrichmentType "nesting material" .

lmt:arena-dimensions a hcm:EnclosureDimensions ;
    hcm:hasHeightQuantity lmt:arena-dimensions-height ;
    hcm:hasLengthQuantity lmt:arena-dimensions-length ;
    hcm:hasWidthQuantity lmt:arena-dimensions-width .

lmt:arena-dimensions-height a qudt:QuantityValue ;
    qudt:hasUnit unit:CentiM ;
    qudt:numericValue 30.0 .

lmt:arena-dimensions-length a qudt:QuantityValue ;
    qudt:hasUnit unit:CentiM ;
    qudt:numericValue 50.0 .

lmt:arena-dimensions-width a qudt:QuantityValue ;
    qudt:hasUnit unit:CentiM ;
    qudt:numericValue 50.0 .

lmt:arena-temperature-target a hcm-env:MeasurementSpecification ;
    rdfs:label "Arena temperature target 22.5 degC" ;
    hcm-env:hasSpecifiedValue lmt:arena-temperature-target-value ;
    hcm-env:specifiesProperty lmt:arena-temperature .

lmt:arena-temperature-target-value a qudt:QuantityValue ;
    qudt:hasUnit unit:DEG_C ;
    qudt:numericValue 22.5 .

