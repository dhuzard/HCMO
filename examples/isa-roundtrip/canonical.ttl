<studies/hcmo-2x2/> a schema1:Dataset ;
    schema1:about ex:process-initial-allocation,
        ex:process-rehousing-animal-1 ;
    schema1:additionalType "Study" ;
    schema1:description "A structural 2 x 2 design fixture; it is not a claim of adequate statistical power." ;
    schema1:hasPart <assays/activity/> ;
    schema1:identifier "HCMO-2X2" ;
    schema1:mentions ex:animal-1,
        ex:animal-2,
        ex:animal-3,
        ex:animal-4,
        ex:animal-5,
        ex:animal-6,
        ex:animal-7,
        ex:animal-8,
        ex:factor-enrichment,
        ex:factor-treatment,
        ex:group-active-enriched,
        ex:group-active-standard,
        ex:group-vehicle-enriched,
        ex:group-vehicle-standard ;
    schema1:name "Treatment by enrichment home-cage study" .

<assays/activity/> a schema1:Dataset ;
    schema1:about ex:process-linear-mixed-model,
        ex:process-recording,
        ex:process-specimen-collection ;
    schema1:additionalType "Assay" ;
    schema1:description "Seven repeated daily dark-phase activity outcomes per individually housed animal." ;
    schema1:hasPart <data/dark-phase-activity.csv>,
        <data/model-results.csv> ;
    schema1:identifier "HCMO-2X2-ACTIVITY" ;
    schema1:name "Repeated dark-phase activity assay" ;
    schema1:variableMeasured ex:dependent-variable-dark-phase-activity .

ex:active-versus-vehicle-contrast a schema1:PropertyValue ;
