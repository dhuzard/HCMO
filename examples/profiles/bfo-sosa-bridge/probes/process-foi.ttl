@prefix ex: <https://example.org/hcmo/bridge-probe#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#> .
@prefix hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Negative probe: a behavioural bout (a process) used as the feature of interest. Inconsistent under the bridge (feature of interest must be a continuant).

ex:bout-1 a BFO:0000015 .
ex:obs-1 a sosa:Observation ;
    sosa:hasFeatureOfInterest ex:bout-1 .
