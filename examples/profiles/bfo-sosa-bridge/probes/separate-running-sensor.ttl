@prefix ex: <https://example.org/hcmo/bridge-probe#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#> .
@prefix hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Separation without a link: code and a distinct running sensor, no relation asserted. Consistent.

ex:tracker-code a hcm-tech:Software .
ex:tracker-run-cage7 a sosa:Sensor ;
    owl:differentFrom ex:tracker-code .
