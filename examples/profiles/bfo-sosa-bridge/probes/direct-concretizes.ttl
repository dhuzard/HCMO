@prefix ex: <https://example.org/hcmo/bridge-probe#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#> .
@prefix hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

# Negative probe: a material sensor concretizes the code directly. Inconsistent with the pinned BFO (domain of concretizes).

ex:tracker-code a hcm-tech:Software .
ex:tracker-run-cage7 a sosa:Sensor ;
    owl:differentFrom ex:tracker-code ;
    BFO:0000059 ex:tracker-code .
