PREFIX obi: <http://purl.obolibrary.org/obo/OBI_>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX schema: <https://schema.org/>
PREFIX stato: <http://purl.obolibrary.org/obo/STATO_>

SELECT ?result ?execution ?inputFile ?outputFile
WHERE {
  ?result a stato:0000401 ;
          prov:wasGeneratedBy ?execution .
  ?execution a obi:0200000 ;
             prov:used ?inputFile ;
             prov:generated ?outputFile .
  ?inputFile a schema:MediaObject .
  ?outputFile a schema:MediaObject ;
              schema:about ?result .
}
ORDER BY ?result ?execution
