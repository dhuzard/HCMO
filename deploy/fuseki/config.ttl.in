## Fuseki 5 server configuration for the HCMO public SPARQL endpoint.
##
## Template: deploy/fuseki/load.sh renders it to $FUSEKI_BASE/config.ttl at image
## build time, replacing the placeholder @HCMO_VERSION@ with the `version:` of
## hcmo.yaml. The placeholder only appears inside a literal, so this template is
## valid Turtle as is. The entrypoint starts Fuseki with --config=<that file>.
##
## Every service is read-only: SPARQL query and Graph Store Protocol read
## (fuseki:gsp-r). There is no update, upload or read-write endpoint, on purpose.
## Syntax follows the templates shipped in fuseki-server.jar
## (org/apache/jena/fuseki/server/templates/config-tdb2) with the Fuseki 5
## fuseki:endpoint / fuseki:operation form.

PREFIX :        <#>
PREFIX fuseki:  <http://jena.apache.org/fuseki#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX tdb2:    <http://jena.apache.org/2016/tdb#>
PREFIX ja:      <http://jena.hpl.hp.com/2005/11/Assembler#>

## ---------------------------------------------------------------
## Server: 30 s query timeout for every dataset (repeated on each dataset
## below, so the limit holds even if one is served on its own).

[] rdf:type fuseki:Server ;
    ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "30000" ] ;
    .

## ---------------------------------------------------------------
## /hcmo: reference evaluation graph of the 12 competency questions
## (ontology + 3 positive examples + 6 vocabularies; see load.sh).

:service_hcmo rdf:type fuseki:Service ;
    rdfs:label    "HCMO reference graph (latest release)" ;
    fuseki:name   "hcmo" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ; fuseki:name "get" ] ;
    # Unnamed endpoints: query and GSP read directly on /hcmo.
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ] ;
    fuseki:dataset :dataset_hcmo ;
    .

## /hcmo-<version>: the SAME dataset resource under a frozen, citable name.
## Both services share :dataset_hcmo, so the data is stored and opened once.

:service_hcmo_release rdf:type fuseki:Service ;
    rdfs:label    "HCMO reference graph, release @HCMO_VERSION@" ;
    fuseki:name   "hcmo-@HCMO_VERSION@" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ; fuseki:name "get" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ] ;
    fuseki:dataset :dataset_hcmo ;
    .

## TDB2 database built by load.sh. The union default graph makes a query
## without GRAPH see all named graphs (what tooling/validate.py evaluates).

:dataset_hcmo rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/hcmo" ;
    tdb2:unionDefaultGraph true ;
    ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "30000" ] ;
    .

## ---------------------------------------------------------------
## /hcm-systems: exploration dataset for the HCM systems catalogue
## (ontology + catalog + DVC example + submissions + 6 vocabularies).
## Not the reference graph: competency-question answers differ here.

:service_hcm_systems rdf:type fuseki:Service ;
    rdfs:label    "HCM systems catalogue (exploration)" ;
    fuseki:name   "hcm-systems" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "query" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ; fuseki:name "get" ] ;
    fuseki:endpoint [ fuseki:operation fuseki:query ] ;
    fuseki:endpoint [ fuseki:operation fuseki:gsp-r ] ;
    fuseki:dataset :dataset_hcm_systems ;
    .

:dataset_hcm_systems rdf:type tdb2:DatasetTDB2 ;
    tdb2:location "/fuseki/databases/hcm-systems" ;
    tdb2:unionDefaultGraph true ;
    ja:context [ ja:cxtName "arq:queryTimeout" ; ja:cxtValue "30000" ] ;
    .
