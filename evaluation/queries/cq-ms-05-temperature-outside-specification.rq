PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-05 (env/obs): Which enclosures recorded an environmental value that
# deviates by more than 0.4 units from the target stated in the enclosure's
# environment profile, and how often?
SELECT ?enclosure ?property ?target (COUNT(?observation) AS ?deviations)
WHERE {
  ?enclosure hcm-env:hasEnvironment/hcm-env:hasMeasurementSpec ?spec .
  ?spec hcm-env:specifiesProperty ?property ;
        hcm-env:hasSpecifiedValue/qudt:numericValue ?target .
  ?observation a hcm-obs:EnvironmentObservation ;
               sosa:hasFeatureOfInterest ?enclosure ;
               sosa:observedProperty ?property ;
               sosa:hasResult/qudt:numericValue ?observed .
  FILTER (ABS(?observed - ?target) > 0.4)
}
GROUP BY ?enclosure ?property ?target
ORDER BY ?enclosure
