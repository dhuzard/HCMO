PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-01 (tech/core): Which sensor technologies monitor enclosures in each
# system, and how many enclosures does each technology cover?
SELECT ?system ?technology (COUNT(DISTINCT ?enclosure) AS ?enclosures)
WHERE {
  ?enclosure a hcm:MonitoredEnclosure ;
             hcm-tech:monitoredBy ?sensor .
  ?sensor hcm-tech:hasSensorTechnology ?technology .
  BIND (REPLACE(STR(?enclosure), "^(https://w3id.org/hcmo/id/eval/[^/]+/).*$", "$1") AS ?system)
}
GROUP BY ?system ?technology
ORDER BY ?system ?technology
