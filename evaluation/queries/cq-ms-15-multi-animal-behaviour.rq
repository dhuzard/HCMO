PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-15 (obs/bio, social behaviour): Which recorded behaviours involve more
# than one animal at the same time, how many animals participate, and how many
# such behaviour results were recorded? A shared BehaviorResult observed about
# several subjects is HCMO's way of representing an n-ary social event, so the
# count of distinct features of interest per result recovers the group size.
SELECT ?behaviorType ?participants (COUNT(DISTINCT ?result) AS ?results)
WHERE {
  {
    SELECT ?result ?behaviorType (COUNT(DISTINCT ?subject) AS ?participants)
    WHERE {
      ?observation a hcm-obs:BehaviorObservation ;
                   sosa:hasResult ?result ;
                   sosa:hasFeatureOfInterest ?subject .
      ?result hcm-obs:hasBehaviorType ?behaviorType .
    }
    GROUP BY ?result ?behaviorType
  }
  FILTER (?participants > 1)
}
GROUP BY ?behaviorType ?participants
ORDER BY DESC(?participants) ?behaviorType
