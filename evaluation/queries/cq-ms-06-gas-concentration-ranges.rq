PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-06 (obs/env): For each enclosure with gas-concentration observations,
# what are the observed ranges per gas property?
SELECT ?enclosure ?property (MIN(?value) AS ?minimum) (MAX(?value) AS ?maximum) ?unit
WHERE {
  ?observation a hcm-obs:GasConcentrationObservation ;
               sosa:hasFeatureOfInterest ?enclosure ;
               sosa:observedProperty ?property ;
               sosa:hasResult ?result .
  ?result qudt:numericValue ?value ;
          qudt:hasUnit ?unit .
}
GROUP BY ?enclosure ?property ?unit
ORDER BY ?enclosure ?property
