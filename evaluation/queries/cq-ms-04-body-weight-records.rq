PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-04 (obs/bio): Which subjects have body-weight observations, from which
# sensor, and what are their minimum and maximum recorded weights?
SELECT ?subject ?sensor (COUNT(?observation) AS ?records) (MIN(?value) AS ?minWeight) (MAX(?value) AS ?maxWeight) ?unit
WHERE {
  ?observation a hcm-obs:WeightObservation ;
               sosa:hasFeatureOfInterest ?subject ;
               sosa:madeBySensor ?sensor ;
               sosa:hasResult ?result .
  ?result qudt:numericValue ?value ;
          qudt:hasUnit ?unit .
}
GROUP BY ?subject ?sensor ?unit
ORDER BY ?subject
