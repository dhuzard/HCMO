PREFIX hcm: <https://w3id.org/hcmo/ontology/hcm#>
PREFIX hcm-bio: <https://w3id.org/hcmo/ontology/hcm/bio#>
PREFIX hcm-env: <https://w3id.org/hcmo/ontology/hcm/env#>
PREFIX hcm-obs: <https://w3id.org/hcmo/ontology/hcm/obs#>
PREFIX hcm-tech: <https://w3id.org/hcmo/ontology/hcm/tech#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX time: <http://www.w3.org/2006/time#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX schema: <https://schema.org/>
PREFIX semts: <https://w3id.org/semts/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# CQ-MS-08 (obs/tech): Which behaviour categories were recognised, by sensors
# of which technology, and how many events were recorded per category?
SELECT ?technology ?behaviorType (COUNT(?observation) AS ?events)
WHERE {
  ?observation a hcm-obs:BehaviorObservation ;
               sosa:madeBySensor ?sensor ;
               sosa:hasResult/hcm-obs:hasBehaviorType ?behaviorType .
  ?sensor hcm-tech:hasSensorTechnology ?technology .
}
GROUP BY ?technology ?behaviorType
ORDER BY ?technology ?behaviorType
